    printf 'Mail Edge integration is disabled\n' >&2
    return 1
  fi
  compose --profile tools run --rm --no-deps app \
    python ops/owned-provider/scripts/mail_edge_lifecycle.py "$@"
}

run_upstream_check() {
  git -C "$repository_root" fetch upstream master:refs/remotes/upstream/master
  local output="$runtime_dir/evidence/upstream-drift-$(date -u +%Y%m%dT%H%M%SZ).json"
  python3 "$script_dir/scripts/upstream_drift.py" \
    --repository "$repository_root" --candidate upstream/master --output "$output"
}

run_mail_edge_contract_check() {
  local contract_repository="${1:?mail-edge-contract-check requires the Mail Edge repository}"
  contract_repository="$(cd "$contract_repository" && pwd)"
  local expected evidence actual parent changed expected_changed
  local stamp log_file temporary temporary_quoted key_id result
  expected="$(tr -d '[:space:]' <"$script_dir/MAIL_EDGE_CONTRACT_COMMIT")"
  evidence="$(tr -d '[:space:]' <"$script_dir/MAIL_EDGE_EVIDENCE_COMMIT")"
  actual="$(git -C "$contract_repository" rev-parse HEAD)"
  if [[ "$actual" != "$expected" ]]; then
    printf 'Mail Edge contract head mismatch: expected %s, got %s\n' "$expected" "$actual" >&2
    return 1
  fi
  if [[ -n "$(git -C "$contract_repository" status --porcelain)" ]]; then
    printf 'Mail Edge contract worktree must be clean\n' >&2
    return 1
  fi
  git -C "$contract_repository" cat-file -e "${evidence}^{commit}"
  parent="$(git -C "$contract_repository" rev-parse "${evidence}^")"
  if [[ "$parent" != "$expected" ]]; then
    printf 'Mail Edge evidence is not the direct child of its source: %s != %s\n' \
      "$parent" "$expected" >&2
    return 1
  fi
  git -C "$contract_repository" merge-base --is-ancestor "$expected" "$evidence"
  changed="$(
    git -C "$contract_repository" diff-tree --no-commit-id --name-only -r \
      "$expected" "$evidence" | LC_ALL=C sort
  )"
  expected_changed="$(printf '%s\n' \
    test/scale/evidence/integration-w9/asset-validation.v1.json \
    test/scale/evidence/integration-w9/formal-execution.v1.json \
    test/scale/evidence/integration-w9/gate-receipts.v1.json \
    test/scale/evidence/integration-w9/local-qualification.v1.json \
    test/scale/evidence/integration-w9/production-drills/evidence.json \
    test/scale/evidence/integration-w9/qualification-public.pem \
    test/scale/evidence/integration-w9/qualification.signed.v1.json \
    test/scale/evidence/integration-w9/qualification.v1.json | LC_ALL=C sort)"
  if [[ "$changed" != "$expected_changed" ]]; then
    printf 'Mail Edge evidence commit changed files outside the canonical evidence set:\n%s\n' \
      "$changed" >&2
    return 1
  fi
  require corepack
  require node
  if [[ "$(node --version)" != "v24.19.0" ]]; then
    printf 'Mail Edge qualification requires Node v24.19.0, got %s\n' \
      "$(node --version)" >&2
    return 1
  fi
  if [[ ! -x "$repository_root/.venv/bin/python3" ]]; then
    printf 'Mail Edge host interoperability requires %s/.venv/bin/python3\n' \
      "$repository_root" >&2
    return 1
  fi
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  log_file="$runtime_dir/evidence/mail-edge-contract-$stamp.log"
  temporary="$(mktemp -d "$runtime_dir/evidence/.mail-edge-evidence.XXXXXX")"
  printf -v temporary_quoted '%q' "$temporary"
  trap "rm -rf -- $temporary_quoted" EXIT
  while IFS= read -r path; do
    mkdir -p "$temporary/$(dirname "$path")"
    git -C "$contract_repository" show "$evidence:$path" >"$temporary/$path"
  done <<<"$expected_changed"
  local evidence_directory="$temporary/test/scale/evidence/integration-w9"
  key_id="$(
    "$repository_root/.venv/bin/python3" -c \
      'import json,sys; print(json.load(open(sys.argv[1]))["signature"]["keyId"])' \
      "$evidence_directory/qualification.signed.v1.json"
  )"
  set +e
  (
    cd "$contract_repository"
    set +e
    failures=0
    run_gate() {
      printf '\n[gate] %s\n' "$*"
      "$@"
      status=$?
      if [[ "$status" -ne 0 ]]; then
        printf '[gate-failed:%s] %s\n' "$status" "$*"
        failures=$((failures + 1))
      fi
    }
    corepack pnpm install --frozen-lockfile || exit $?
    run_gate corepack pnpm --filter @mail-edge/w9-scale-qualification build
    run_gate node test/scale/dist/cli.js verify \
      --input "$evidence_directory/qualification.signed.v1.json" \
      --public-key "$evidence_directory/qualification-public.pem" \
      --key-id "$key_id"
    run_gate "$repository_root/.venv/bin/python3" \
      "$script_dir/scripts/mail_edge_evidence.py" \
      --directory "$evidence_directory" \
      --source-sha "$expected" \
      --evidence-sha "$evidence"
    run_gate env \
      "PATH=$repository_root/.venv/bin:$PATH" \
      "MAIL_EDGE_SIMPLELOGIN_BASELINE=$repository_root" \
      corepack pnpm --filter @mail-edge/core exec vitest run --reporter verbose
    run_gate corepack pnpm test:w2-integration
    run_gate corepack pnpm reference-service:e2e
    run_gate corepack pnpm reference-service:container
    run_gate corepack pnpm run verify
    exit "$failures"
  ) >"$log_file" 2>&1
  result=$?
  set -e
  tail -120 "$log_file"
  if [[ "$result" -ne 0 ]]; then
    return "$result"
  fi
  if [[ -n "$(git -C "$contract_repository" status --porcelain)" ]]; then
    printf 'Mail Edge verification changed its source worktree\n' >&2
    return 1
  fi
  rm -rf -- "$temporary"
  trap - EXIT
  printf '{"contract_head":"%s","evidence_commit":"%s","evidence_signature":"passed","full_verify":"passed","host_interop":"passed","reference_service_container":"passed","reference_service_e2e":"passed","w2_integration":"passed","log":"%s"}\n' \
    "$actual" "$evidence" "$log_file"
}

run_endpoints() {
  local mailpit=null
  if is_test_mode; then
    mailpit="\"$(service_url mailpit 8025)\""
  fi
  printf '{"api":"%s","mailpit":%s,"metrics":"%s","project":"%s","smtp_port":%s}\n' \
    "$(service_url app 7777)" \
    "$mailpit" \
    "$(service_url observer 9090)" \
    "$project_name" \
    "$(published_port email 20381)"
}

usage() {
  sed -n 's/^# @command /  /p' "$0"
}

load_configuration
require docker
require curl
docker info >/dev/null
docker compose version >/dev/null

case "${1:-}" in
  # @command init                         Generate contained-test config and mode-0600 secrets
  init)
    compose config --quiet
    printf 'runtime initialized at %s\n' "$runtime_dir"
    ;;
  # @command build                        Build the pinned SimpleLogin image
  build) build_images ;;
  # @command up                           Migrate, bootstrap, and start the provider
  up)
    build_images
    start_application
    run_status
    ;;
  # @command status                       Check readiness and durable state
  status) run_status ;;
  # @command endpoints                    Print this runtime's loopback endpoints
  endpoints) run_endpoints ;;
  # @command metrics                      Print Prometheus metrics
  metrics) curl --silent --show-error --fail "$(service_url observer 9090 /metrics)" ;;
  # @command probe                        Run one alertable API and SMTP synthetic
  probe) compose --profile tools run --rm --no-deps e2e python ops/owned-provider/scripts/synthetic_probe.py ;;
  # @command socket-gate                  Reject HTTP smuggling, part bombs, and oversized SMTP input
  socket-gate)
    if ! is_test_mode; then
      printf 'the hostile socket gate is restricted to contained test mode\n' >&2
      exit 1
    fi
    python3 "$script_dir/scripts/socket_security_probe.py" \
      --http-port "$(published_port app 7777)" \
      --smtp-port "$(published_port email 20381)" \
      --smtp-size-limit "${OWNED_PROVIDER_SMTP_SIZE_LIMIT:-26214400}"
    ;;
  # @command e2e                          Run real API and mail lifecycle tests
  e2e)
    if ! is_test_mode; then
      printf 'end-to-end fixtures are restricted to contained test mode\n' >&2
      exit 1
    fi
    compose --profile tools run --rm e2e
    ;;
  # @command queue-drill                  Prove job deduplication and retry after failure
  queue-drill) run_queue_drill ;;
  # @command restart-drill                Restart processes and prove API/mail resume
  restart-drill) run_restart_drill ;;
  # @command load [COUNT]                 Exercise at least 10,000 aliases
  load) run_load "${2:-10000}" ;;
  # @command reconcile                    Validate alias/domain/mailbox relationships
  reconcile) run_reconcile ;;
  # @command mail-edge-restore-probe ARGS Run the contained Mail Edge restore proof
  mail-edge-restore-probe) shift; run_mail_edge_restore_probe "$@" ;;
  # @command lifecycle ARGS               Run idempotent domain/mailbox operator actions
  lifecycle) shift; run_lifecycle "$@" ;;
  # @command mail-edge-lifecycle ARGS     Run provider-neutral binding/quarantine controls
  mail-edge-lifecycle) shift; run_mail_edge_lifecycle "$@" ;;
  # @command dns-preflight DOMAIN         Read-only MX/SPF/DKIM/DMARC/PTR checks
  dns-preflight) run_dns_preflight "${2:-}" ;;
  # @command export [DIR]                 Create a checksummed all-state checkpoint
  export) run_export "${2:-}" ;;
  # @command import DIR                   Restore a plaintext checkpoint into clean volumes
  import) run_import "${2:-}" ;;
  # @command backup [FILE.opb]            Create an AES-256-GCM encrypted all-state backup
  backup) run_backup "${2:-}" ;;
  # @command restore FILE.opb             Restore an encrypted backup into clean volumes
  restore) run_restore "${2:-}" ;;
  # @command post-restore                 Prove API and mail traffic after recovery
  post-restore) run_post_restore ;;
  # @command drill                        Run lifecycle, retry, restart, load, and restore proof
  drill) run_drill ;;
  # @command sdk-conformance DIR          Run the SDK real-provider contract test
  sdk-conformance)
    sdk_worktree="${2:?sdk-conformance requires the SDK laboratory worktree}"
    python3 "$script_dir/scripts/sdk_conformance.py" "$sdk_worktree" \
      --base-url "$(service_url app 7777)" \
      --email "$OWNED_PROVIDER_ADMIN_EMAIL" \
      --password-file "$runtime_dir/secrets/admin_password" \
      --target-dir "$runtime_dir/sdk-target"
    ;;
  # @command audit                        Audit provenance, secrets, config, and hardening
  audit)
    python3 "$script_dir/scripts/config_audit.py" --runtime "$runtime_dir"
    run_status
    python3 "$script_dir/scripts/host_audit.py" \
      --repository "$repository_root" --runtime "$runtime_dir" --project "$project_name"
    ;;
  # @command distribution-audit           Audit packaged licenses, tools, and exact source provenance
  distribution-audit)
    python3 "$script_dir/scripts/distribution_audit.py" \
      --repository "$repository_root" --image "$image"
    ;;
  # @command production-audit             Fail closed on unsafe production configuration
  production-audit)
    python3 "$script_dir/scripts/config_audit.py" --runtime "$runtime_dir" --production
    compose config --quiet
    ;;
  # @command upstream-check               Report replay conflicts and compatibility drift
  upstream-check) run_upstream_check ;;
  # @command mail-edge-contract-check DIR Verify and exercise the exact reference service contract
  mail-edge-contract-check) run_mail_edge_contract_check "${2:-}" ;;
  restore-fixture-verify) run_restore_fixture_verify "${2:-}" "${3:-}" ;;
  # @command logs                         Follow structured provider logs
  logs) compose logs --follow --tail 200 app email job-runner observer synthetic postgres redis mailpit ;;
  # @command down                         Stop containers but retain data
  down) compose down --remove-orphans ;;
  # @command destroy                      Remove only this deployment's containers and volumes
  destroy) compose down --volumes --remove-orphans ;;
  *) usage >&2; exit 2 ;;
esac
