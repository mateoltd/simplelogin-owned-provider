#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repository_root="$(git -C "$script_dir" rev-parse --show-toplevel)"
runtime_dir="${OWNED_PROVIDER_RUNTIME_DIR:-$repository_root/.owned-provider}"
config_file="${OWNED_PROVIDER_CONFIG_FILE:-$runtime_dir/config.env}"
compose_file="$script_dir/compose.yml"
project_name=
source_commit="$(tr -d '[:space:]' <"$script_dir/UPSTREAM_COMMIT")"
owned_provider_commit="$(git -C "$repository_root" rev-parse HEAD)"
owned_provider_source_epoch="$(git -C "$repository_root" show -s --format=%ct "$owned_provider_commit")"
image="simplelogin-owned-provider:$owned_provider_commit"
database_secret_names=(postgres_password)
application_secret_names=(
  flask_secret
  partner_api_token_secret
  recovery_code_hmac_secret
  alias_transfer_token_secret
  verp_email_secret
  master_enc_key_hex
  mac_key_hex
  abuser_hkdf_salt
  dkim_private_key
  openid_private_key
  mail_edge_tenant_bearer
  mail_edge_opaque_token_key
  mail_edge_host_key_current
  mail_edge_host_key_previous
  mail_edge_operator_bearer
  mail_edge_privileged_operator_bearer
)
operator_secret_names=(admin_password)

require() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'required command not found: %s\n' "$1" >&2
    exit 1
  }
}

initialize_runtime() {
  require openssl
  mkdir -p "$runtime_dir/secrets" "$runtime_dir/backups" "$runtime_dir/exports" "$runtime_dir/evidence" "$runtime_dir/sdk-target"
  chmod 700 "$runtime_dir" "$runtime_dir/secrets" "$runtime_dir/backups" "$runtime_dir/exports" "$runtime_dir/evidence"
  if [[ ! -f "$config_file" ]]; then
    if [[ -n "${OWNED_PROVIDER_CONFIG_FILE:-}" ]]; then
      printf 'configured environment file does not exist: %s\n' "$config_file" >&2
      exit 1
    fi
    {
      printf 'OWNED_PROVIDER_RUNTIME_DIR=%s\n' "$runtime_dir"
      printf 'SIMPLELOGIN_UPSTREAM_COMMIT=%s\n' "$source_commit"
      sed -n '/^[A-Z_][A-Z_]*=/p' "$script_dir/config.env.example"
    } >"$config_file.tmp"
    chmod 600 "$config_file.tmp"
    mv "$config_file.tmp" "$config_file"
  fi
  chmod 600 "$config_file"
  local name
  for name in \
    postgres_password flask_secret partner_api_token_secret \
    recovery_code_hmac_secret alias_transfer_token_secret verp_email_secret \
    master_enc_key_hex mac_key_hex abuser_hkdf_salt backup_encryption_key \
    mail_edge_tenant_bearer mail_edge_opaque_token_key \
    mail_edge_host_key_current mail_edge_host_key_previous \
    mail_edge_operator_bearer mail_edge_privileged_operator_bearer
  do
    if [[ ! -f "$runtime_dir/secrets/$name" ]]; then
      openssl rand -hex 32 >"$runtime_dir/secrets/$name"
      chmod 600 "$runtime_dir/secrets/$name"
    fi
  done
  if [[ ! -f "$runtime_dir/secrets/admin_password" ]]; then
    openssl rand -base64 30 | tr -d '\r\n' >"$runtime_dir/secrets/admin_password"
    printf '\n' >>"$runtime_dir/secrets/admin_password"
    chmod 600 "$runtime_dir/secrets/admin_password"
  fi
  if [[ ! -f "$runtime_dir/secrets/dkim_private_key" ]]; then
    # dkimpy at the pinned upstream revision requires traditional PKCS#1 PEM.
    openssl genrsa -traditional -out "$runtime_dir/secrets/dkim_private_key" 2048 \
      2>/dev/null
    chmod 600 "$runtime_dir/secrets/dkim_private_key"
  fi
  if [[ ! -f "$runtime_dir/secrets/openid_private_key" ]]; then
    openssl genrsa -traditional -out "$runtime_dir/secrets/openid_private_key" 4096 \
      2>/dev/null
    chmod 600 "$runtime_dir/secrets/openid_private_key"
  fi
}

load_env_file() {
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ ! "$line" =~ ^(OWNED_PROVIDER_[A-Z0-9_]+|SIMPLELOGIN_UPSTREAM_COMMIT)=(.*)$ ]]; then
      printf 'invalid or unsupported configuration entry\n' >&2
      return 1
    fi
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    if [[ "$value" =~ ^\'(.*)\'$ || "$value" =~ ^\"(.*)\"$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
    export "$key=$value"
  done <"$config_file"
}

clear_configuration_environment() {
  local name
  while IFS= read -r name; do
    unset "$name"
  done < <(compgen -v | sed -n '/^OWNED_PROVIDER_/p')
  unset SIMPLELOGIN_UPSTREAM_COMMIT
}

set_runtime_namespace() {
  local -a arguments=(
    --repository "$repository_root"
    --runtime "$runtime_dir"
  )
  if [[ -n "${OWNED_PROVIDER_PROJECT_NAME:-}" ]]; then
    arguments+=(--explicit "$OWNED_PROVIDER_PROJECT_NAME")
  fi
  project_name="$(python3 "$script_dir/scripts/runtime_namespace.py" "${arguments[@]}")"
  export OWNED_PROVIDER_PROJECT_NAME="$project_name"
}

load_configuration() {
  initialize_runtime
  clear_configuration_environment
  load_env_file
  set_runtime_namespace
  if [[ -n "${SIMPLELOGIN_UPSTREAM_COMMIT:-}" && "$SIMPLELOGIN_UPSTREAM_COMMIT" != "$source_commit" ]]; then
    printf 'configuration attempted to override the pinned upstream commit\n' >&2
    exit 1
  fi
  export OWNED_PROVIDER_RUNTIME_DIR="$runtime_dir"
  export OWNED_PROVIDER_CONFIG_FILE="$config_file"
  export OWNED_PROVIDER_SOURCE_COMMIT="$owned_provider_commit"
  export OWNED_PROVIDER_SOURCE_DATE_EPOCH="$owned_provider_source_epoch"
  export SIMPLELOGIN_UPSTREAM_COMMIT="$source_commit"
  python3 "$script_dir/scripts/mail_edge_config.py" "$runtime_dir/mail-edge.json"
  if [[ "${OWNED_PROVIDER_MAIL_EDGE_ENABLED:-0}" == "1" ]]; then
    export OWNED_PROVIDER_MAIL_EDGE_CONFIG_PATH=/run/mail-edge/config.json
  elif [[ "${OWNED_PROVIDER_MAIL_EDGE_ENABLED:-0}" == "0" ]]; then
    unset OWNED_PROVIDER_MAIL_EDGE_CONFIG_PATH
  else
    printf 'OWNED_PROVIDER_MAIL_EDGE_ENABLED must be 0 or 1\n' >&2
    exit 1
  fi
  [[ "$source_commit" =~ ^[0-9a-f]{40}$ ]]
  git -C "$repository_root" cat-file -e "${source_commit}^{commit}"
}

compose() {
  if is_test_mode; then
    docker compose --project-name "$project_name" --env-file "$config_file" \
      --file "$compose_file" --profile test "$@"
  else
    docker compose --project-name "$project_name" --env-file "$config_file" \
      --file "$compose_file" "$@"
  fi
}

published_port() {
  local service="$1"
  local container_port="$2"
  local mapping
  mapping="$(compose port "$service" "$container_port")"
  if [[ "$mapping" == *$'\n'* || ! "$mapping" =~ :([0-9]{1,5})$ ]] || \
     ((10#${BASH_REMATCH[1]:-0} < 1 || 10#${BASH_REMATCH[1]:-0} > 65535)); then
    printf 'cannot resolve one published port for %s:%s: %s\n' \
      "$service" "$container_port" "$mapping" >&2
    return 1
  fi
  printf '%s\n' "${BASH_REMATCH[1]}"
}

service_url() {
  local service="$1"
  local container_port="$2"
  local path="${3:-}"
  local bind
  case "$service" in
    app) bind="${OWNED_PROVIDER_HTTP_BIND:-127.0.0.1}" ;;
    observer) bind="${OWNED_PROVIDER_OBSERVER_BIND:-127.0.0.1}" ;;
    *) bind=127.0.0.1 ;;
  esac
  case "$bind" in
    0.0.0.0) bind=127.0.0.1 ;;
    ::) bind=::1 ;;
  esac
  if [[ "$bind" == *:* && "$bind" != \[*\] ]]; then
    bind="[$bind]"
  fi
  printf 'http://%s:%s%s\n' \
    "$bind" "$(published_port "$service" "$container_port")" "$path"
}

is_test_mode() {
  [[ "${OWNED_PROVIDER_MODE:-test}" == "test" ]]
}

mail_store_up() {
  if is_test_mode; then
    compose up --detach mailpit
  fi
}

mail_store_stop() {
  if is_test_mode; then
    compose stop mailpit
  fi
}

wait_for_url() {
  local url="$1"
  local attempts="${2:-120}"
  local attempt
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if curl --silent --show-error --fail --connect-timeout 2 --max-time 5 "$url" >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done
  printf 'timed out waiting for %s\n' "$url" >&2
  return 1
}

ensure_volume() {
  local volume="$1"
  local logical_name="$2"
  if docker volume inspect "$volume" >/dev/null 2>&1; then
    local labels
    labels="$(
      docker volume inspect --format \
        '{{ index .Labels "com.docker.compose.project" }}:{{ index .Labels "com.docker.compose.volume" }}' \
        "$volume"
    )"
    if [[ "$labels" != "$project_name:$logical_name" ]]; then
      printf 'refusing volume outside this runtime namespace: %s (%s)\n' \
        "$volume" "$labels" >&2
      return 1
    fi
  else
    docker volume create \
      --label "com.docker.compose.project=$project_name" \
      --label "com.docker.compose.volume=$logical_name" \
      "$volume" >/dev/null
  fi
}

stage_secret_volume() {
  local logical_name="$1"
  shift
  local volume="${project_name}_${logical_name}"
  local name path mode
  ensure_volume "$volume" "$logical_name"
  for name in "$@"; do
    path="$runtime_dir/secrets/$name"
    if [[ ! -f "$path" || -L "$path" ]]; then
      printf 'required secret is not a regular file: %s\n' "$name" >&2
      return 1
    fi
    mode="$(stat --format '%a' "$path")"
    if [[ "$mode" != 600 ]]; then
      printf 'secret %s has mode %s, expected 600\n' "$name" "$mode" >&2
      return 1
    fi
  done
  docker run --rm --platform linux/amd64 --user 0 --network none --read-only \
    --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER \
    --security-opt no-new-privileges:true \
    --mount type=bind,source="$runtime_dir/secrets",target=/source,readonly \
    --mount type=volume,source="$volume",target=/target,volume-nocopy \
    --entrypoint sh "$image" -c '
set -eu
rm -f /target/*
for extra in /target/.[!.]* /target/..?*; do
  if [ -e "$extra" ] || [ -L "$extra" ]; then
    echo "unexpected hidden entry in secret volume" >&2
    exit 1
  fi
done
for name do
  cp "/source/$name" "/target/$name"
  chown 65532:65532 "/target/$name"
  chmod 0400 "/target/$name"
done
' owned-provider-secret-stage "$@"
  docker run --rm --platform linux/amd64 --user 65532:65532 --network none \
    --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --mount type=volume,source="$volume",target=/target,readonly,volume-nocopy \
    --entrypoint sh "$image" -c '
set -eu
for name do
  test -f "/target/$name"
  test ! -L "/target/$name"
  test -r "/target/$name"
  test "$(stat -c %a "/target/$name")" = 400
  test "$(stat -c %u:%g "/target/$name")" = 65532:65532
done
' owned-provider-secret-verify "$@"
}

stage_runtime_config() {
  local source_path="$runtime_dir/mail-edge.json"
  local logical_name=runtime-config
  local volume="${project_name}_${logical_name}"
  local mode
  ensure_volume "$volume" "$logical_name"
  if [[ ! -f "$source_path" || -L "$source_path" ]]; then
    printf 'rendered Mail Edge configuration is not a regular file\n' >&2
    return 1
  fi
  mode="$(stat --format '%a' "$source_path")"
  if [[ "$mode" != 600 ]]; then
    printf 'rendered Mail Edge configuration has mode %s, expected 600\n' \
      "$mode" >&2
    return 1
  fi
  docker run --rm --platform linux/amd64 --user 0 --network none --read-only \
    --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER \
    --security-opt no-new-privileges:true \
    --mount type=bind,source="$source_path",target=/source,readonly \
    --mount type=volume,source="$volume",target=/target,volume-nocopy \
    --entrypoint sh "$image" -c '
set -eu
rm -f /target/*
for extra in /target/.[!.]* /target/..?*; do
  if [ -e "$extra" ] || [ -L "$extra" ]; then
    echo "unexpected hidden entry in runtime config volume" >&2
    exit 1
  fi
done
cp /source /target/config.json
chown 65532:65532 /target/config.json
chmod 0400 /target/config.json
'
  docker run --rm --platform linux/amd64 --user 65532:65532 --network none \
    --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --mount type=volume,source="$volume",target=/target,readonly,volume-nocopy \
    --entrypoint sh "$image" -c '
set -eu
test -f /target/config.json
test ! -L /target/config.json
test -r /target/config.json
test "$(stat -c %a /target/config.json)" = 400
test "$(stat -c %u:%g /target/config.json)" = 65532:65532
'
}

prepare_runtime_mounts() {
  stage_secret_volume database-secrets "${database_secret_names[@]}"
  stage_secret_volume application-secrets "${application_secret_names[@]}"
  stage_secret_volume operator-secrets "${operator_secret_names[@]}"
  stage_runtime_config
}

prepare_volumes() {
  ensure_volume "${project_name}_uploads" uploads
  ensure_volume "${project_name}_unsent" unsent
  ensure_volume "${project_name}_mail-edge-spool" mail-edge-spool
  local -a volume_mounts=(
    --mount type=volume,source="${project_name}_uploads",target=/code/static/upload,volume-nocopy
    --mount type=volume,source="${project_name}_unsent",target=/code/var/unsent,volume-nocopy
    --mount type=volume,source="${project_name}_mail-edge-spool",target=/code/var/mail-edge-spool,volume-nocopy
  )
  docker run --rm --platform linux/amd64 --user 0 --entrypoint sh \
    "${volume_mounts[@]}" \
    "$image" -c 'chown -R 65532:65532 /code/static/upload /code/var/unsent /code/var/mail-edge-spool'
  docker run --rm --platform linux/amd64 --user 65532:65532 --entrypoint sh \
    "${volume_mounts[@]}" \
    "$image" -c 'test -w /code/static/upload && test -w /code/var/unsent && test -w /code/var/mail-edge-spool'
}

build_images() {
  local initial_head initial_tree upstream_image
  initial_head="$(git -C "$repository_root" rev-parse HEAD)"
  initial_tree="$(git -C "$repository_root" rev-parse HEAD^{tree})"
  upstream_image="simplelogin-owned-provider-upstream:$owned_provider_commit"
  if [[ "$initial_head" != "$owned_provider_commit" ]] || \
     [[ -n "$(git -C "$repository_root" status --porcelain --untracked-files=normal)" ]]; then
    printf 'refusing to build: commit or remove source changes so OCI provenance is exact\n' >&2
    return 1
  fi
  git -C "$repository_root" archive --format=tar "$initial_head" | \
    docker buildx build --no-cache --platform linux/amd64 --load \
      --build-arg "OWNED_PROVIDER_SOURCE_COMMIT=$owned_provider_commit" \
      --build-arg "SIMPLELOGIN_UPSTREAM_COMMIT=$source_commit" \
      --build-arg "SOURCE_DATE_EPOCH=$owned_provider_source_epoch" \
      --tag "$upstream_image" -
  git -C "$repository_root" archive --format=tar "$initial_head" | \
    docker buildx build --no-cache --platform linux/amd64 --load \
      --build-arg "BASE_IMAGE=$upstream_image" \
      --file ops/owned-provider/Dockerfile \
      --tag "$image" -
  if [[ "$(git -C "$repository_root" rev-parse HEAD)" != "$initial_head" ]] || \
     [[ "$(git -C "$repository_root" rev-parse HEAD^{tree})" != "$initial_tree" ]] || \
     [[ -n "$(git -C "$repository_root" status --porcelain --untracked-files=normal)" ]]; then
    printf 'refusing built artifact: source worktree changed during the OCI build\n' >&2
    return 1
  fi
}

run_migrations() {
  compose --profile tools run --rm migrate
  compose --profile tools run --rm ops-migrate
  compose --profile tools run --rm initialize
}

start_application() {
  # Stop secret consumers before refreshing their isolated volume copies, then
  # recreate stateful containers without touching their durable data volumes.
  compose stop synthetic observer app email job-runner postgres >/dev/null
  prepare_runtime_mounts
  compose up --detach --force-recreate postgres redis
  mail_store_up
  prepare_volumes
  run_migrations
  compose --profile tools run --rm bootstrap
  compose up --detach --force-recreate app email job-runner
  wait_for_url "$(service_url app 7777 /health)"
  compose up --detach --force-recreate observer synthetic
  wait_for_url "$(service_url observer 9090 /readyz)"
}

run_status() {
  curl --silent --show-error --fail "$(service_url observer 9090 /readyz)"
  compose --profile tools run --rm --no-deps \
    -e OWNED_PROVIDER_BASE_URL=http://app:7777 \
    app python ops/owned-provider/scripts/operational_check.py
}

archive_volume() {
  local volume="$1"
  local output="$2"
  docker run --rm --platform linux/amd64 --user 0 --entrypoint tar \
    -v "$volume:/source:ro" "$image" \
    --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
    --format=posix --pax-option=delete=atime,delete=ctime \
    -C /source -cf - . >"$output"
}

restore_volume() {
  local volume="$1"
  local logical_name="$2"
  local input="$3"
  ensure_volume "$volume" "$logical_name"
  docker run --rm --platform linux/amd64 --user 0 --entrypoint tar \
    -i -v "$volume:/target" "$image" -C /target -xf - <"$input"
}

restart_after_checkpoint() {
  compose up --detach postgres redis >/dev/null
  mail_store_up >/dev/null
  compose up --detach app email job-runner >/dev/null
  wait_for_url "$(service_url app 7777 /health)"
  compose up --detach observer synthetic >/dev/null
  wait_for_url "$(service_url observer 9090 /readyz)"
}

run_export() {
  local output="${1:-$runtime_dir/exports/state-$(date -u +%Y%m%dT%H%M%SZ)}"
  if [[ -e "$output" ]]; then
    printf 'export destination already exists: %s\n' "$output" >&2
    return 1
  fi
  mkdir -p "$output"
  chmod 700 "$output"
  run_status >/dev/null
  compose stop synthetic observer app email job-runner >/dev/null
  local restart_required=1
  trap 'if [[ "$restart_required" == 1 ]]; then restart_after_checkpoint; fi' EXIT
  compose exec --no-TTY redis redis-cli SAVE >/dev/null
  compose --profile tools run --rm --no-deps app \
    python ops/owned-provider/scripts/database_digest.py | tail -1 \
    >"$output/database-digest.json"
  compose exec --no-TTY postgres pg_dump \
    --username simplelogin --dbname simplelogin --format=custom \
    --compress=0 --no-owner --no-acl >"$output/database.dump"
  local schema_revision postgres_version checkpoint
  schema_revision="$(compose exec --no-TTY postgres psql --username simplelogin --dbname simplelogin --tuples-only --no-align --command 'SELECT version_num FROM alembic_version;')"
  postgres_version="$(compose exec --no-TTY postgres psql --username simplelogin --dbname simplelogin --tuples-only --no-align --command 'SHOW server_version;')"
  checkpoint="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  compose stop postgres redis >/dev/null
  mail_store_stop >/dev/null
  archive_volume "${project_name}_uploads" "$output/uploads.tar"
  archive_volume "${project_name}_unsent" "$output/unsent.tar"
  archive_volume "${project_name}_redis" "$output/redis.tar"
  local components='["postgres","redis","uploads","unsent","mail-edge-host-projections"]'
  if is_test_mode; then
    archive_volume "${project_name}_mailpit" "$output/mail-store.tar"
    components='["postgres","redis","uploads","unsent","mail-store","mail-edge-host-projections"]'
  fi
  {
    printf 'format=simplelogin-owned-provider-state\n'
    printf 'format_version=3\n'
    printf 'upstream_commit=%s\n' "$source_commit"
    printf 'local_head=%s\n' "$(git -C "$repository_root" rev-parse HEAD)"
    printf 'schema_revision=%s\n' "$schema_revision"
    printf 'postgres_version=%s\n' "$postgres_version"
    printf 'checkpoint_utc=%s\n' "$checkpoint"
    printf 'components=%s\n' "$components"
    printf 'database_sha256=%s\n' "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha256"])' "$output/database-digest.json")"
    printf 'mail_edge_config_sha256=%s\n' "$(shasum -a 256 "$runtime_dir/mail-edge.json" | awk '{print $1}')"
  } >"$output/MANIFEST"
  (
    cd "$output"
    find . -maxdepth 1 -type f ! -name SHA256SUMS -print | LC_ALL=C sort | \
      xargs shasum -a 256 >SHA256SUMS
  )
  restart_required=0
  trap - EXIT
  restart_after_checkpoint
  printf '%s\n' "$output"
}

verify_export() {
  local state_dir="$1"
  [[ -f "$state_dir/MANIFEST" && -f "$state_dir/SHA256SUMS" ]]
  (cd "$state_dir" && shasum -a 256 --check SHA256SUMS) >&2
  grep -qx 'format=simplelogin-owned-provider-state' "$state_dir/MANIFEST"
  grep -qx "upstream_commit=$source_commit" "$state_dir/MANIFEST"
  local version
  version="$(sed -n 's/^format_version=//p' "$state_dir/MANIFEST")"
  case "$version" in
    2|3) ;;
    *)
      printf 'unsupported state export format version: %s\n' "$version" >&2
      return 1
      ;;
  esac
  printf '%s\n' "$version"
}

run_import() {
  local state_dir="${1:?import requires a state export directory}"
  state_dir="$(cd "$state_dir" && pwd)"
  local state_version
  state_version="$(verify_export "$state_dir")"
  if [[ "$state_version" == 3 ]]; then
    local expected_config actual_config
    expected_config="$(sed -n 's/^mail_edge_config_sha256=//p' "$state_dir/MANIFEST")"
    actual_config="$(shasum -a 256 "$runtime_dir/mail-edge.json" | awk '{print $1}')"
    if [[ -z "$expected_config" || "$expected_config" != "$actual_config" ]]; then
      printf 'Mail Edge configuration differs from the state checkpoint\n' >&2
      return 1
    fi
  fi
  compose down --volumes --remove-orphans
  ensure_volume "${project_name}_uploads" uploads
  ensure_volume "${project_name}_unsent" unsent
  ensure_volume "${project_name}_redis" redis
  ensure_volume "${project_name}_mail-edge-spool" mail-edge-spool
  if [[ -f "$state_dir/mail-store.tar" ]]; then
    ensure_volume "${project_name}_mailpit" mailpit
  fi
  prepare_runtime_mounts
  compose up --detach --wait postgres
  compose exec --no-TTY postgres pg_restore \
    --username simplelogin --dbname simplelogin --clean --if-exists \
    --no-owner --no-acl <"$state_dir/database.dump"
  restore_volume "${project_name}_uploads" uploads "$state_dir/uploads.tar"
  restore_volume "${project_name}_unsent" unsent "$state_dir/unsent.tar"
  restore_volume "${project_name}_redis" redis "$state_dir/redis.tar"
  if [[ -f "$state_dir/mail-store.tar" ]]; then
    restore_volume "${project_name}_mailpit" mailpit "$state_dir/mail-store.tar"
  fi
  prepare_volumes
  compose up --detach redis
  mail_store_up
  if [[ "$state_version" == 2 ]]; then
    compose --profile tools run --rm --no-deps app \
      python ops/owned-provider/scripts/database_digest.py --legacy-pre-mail-edge | tail -1 \
      >"$runtime_dir/evidence/import-digest.json"
  else
    compose --profile tools run --rm --no-deps app \
      python ops/owned-provider/scripts/database_digest.py | tail -1 \
      >"$runtime_dir/evidence/import-digest.json"
  fi
  local expected actual
  expected="$(sed -n 's/^database_sha256=//p' "$state_dir/MANIFEST")"
  actual="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha256"])' "$runtime_dir/evidence/import-digest.json")"
  if [[ "$expected" != "$actual" ]]; then
    printf 'database semantic digest mismatch: expected %s, got %s\n' "$expected" "$actual" >&2
    return 1
  fi
  run_migrations
  compose up --detach app email job-runner
  wait_for_url "$(service_url app 7777 /health)"
  compose up --detach observer synthetic
  wait_for_url "$(service_url observer 9090 /readyz)"
  run_status >/dev/null
  printf '{"database_sha256":"%s","state_import":"ok"}\n' "$actual"
}

run_crypto() {
  local action="$1"
  local source="$2"
  local destination="$3"
  local source_dir destination_dir
  source_dir="$(cd "$(dirname "$source")" && pwd)"
  destination_dir="$(cd "$(dirname "$destination")" && pwd)"
  docker run --rm --platform linux/amd64 --user "$(id -u):$(id -g)" \
    --entrypoint python \
    -v "$source_dir:/source:ro" \
    -v "$destination_dir:/destination" \
    -v "$runtime_dir/secrets/backup_encryption_key:/run/backup-key:ro" \
    "$image" ops/owned-provider/scripts/backup_crypto.py "$action" \
    "/source/$(basename "$source")" "/destination/$(basename "$destination")" \
    --key-file /run/backup-key
}

run_backup() {
  local output="${1:-$runtime_dir/backups/backup-$(date -u +%Y%m%dT%H%M%SZ).opb}"
  if [[ "$output" != *.opb ]]; then
    printf 'encrypted backup must use the .opb suffix\n' >&2
    return 1
  fi
  if [[ -e "$output" ]]; then
    printf 'backup destination already exists: %s\n' "$output" >&2
    return 1
  fi
  local temporary state_dir archive output_dir
  temporary="$(mktemp -d "$runtime_dir/backups/.build.XXXXXX")"
  trap 'rm -rf -- "$temporary"' EXIT
  state_dir="$temporary/state"
  (run_export "$state_dir") >/dev/null
  mkdir -p "$temporary/control/secrets"
  cp "$config_file" "$temporary/control/config.env"
  cp "$runtime_dir/mail-edge.json" "$temporary/control/mail-edge.json"
  local secret
  for secret in "$runtime_dir"/secrets/*; do
    if [[ "$(basename "$secret")" != "backup_encryption_key" ]]; then
      cp "$secret" "$temporary/control/secrets/"
    fi
  done
  chmod 600 "$temporary/control/config.env" "$temporary/control/mail-edge.json" "$temporary/control/secrets"/*
  {
    printf 'format=simplelogin-owned-provider-control\n'
    printf 'format_version=1\n'
    printf 'config_sha256=%s\n' "$(shasum -a 256 "$temporary/control/config.env" | awk '{print $1}')"
    printf 'mail_edge_config_sha256=%s\n' "$(shasum -a 256 "$temporary/control/mail-edge.json" | awk '{print $1}')"
    printf 'secret_names=%s\n' "$(find "$temporary/control/secrets" -maxdepth 1 -type f -exec basename {} \; | LC_ALL=C sort | python3 -c 'import json,sys; print(json.dumps([line.strip() for line in sys.stdin if line.strip()], separators=(",", ":")))')"
  } >"$temporary/control/MANIFEST"
  archive="$temporary/backup.tar"
  docker run --rm --platform linux/amd64 --user "$(id -u):$(id -g)" --entrypoint tar \
    -v "$temporary:/source" "$image" \
    --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
    --format=posix --pax-option=delete=atime,delete=ctime \
    -C /source -cf /source/backup.tar state control
  output_dir="$(dirname "$output")"
  mkdir -p "$output_dir"
  chmod 700 "$output_dir"
  run_crypto encrypt "$archive" "$output"
  shasum -a 256 "$output" >"$output.sha256"
  local backup_size backup_sha
  backup_size="$(wc -c <"$output" | tr -d '[:space:]')"
  backup_sha="$(shasum -a 256 "$output" | awk '{print $1}')"
  compose --profile tools run --rm --no-deps app \
    python ops/owned-provider/scripts/record_backup.py \
    --size "$backup_size" --sha256 "$backup_sha" >/dev/null
  rm -rf -- "$temporary"
  trap - EXIT
  printf '%s\n' "$output"
}

extract_backup() {
  local backup="$1"
  local temporary="$2"
  local archive="$temporary/backup.tar"
  if [[ -f "$backup.sha256" ]]; then
    shasum -a 256 --check "$backup.sha256"
  fi
  run_crypto decrypt "$backup" "$archive"
  docker run --rm --platform linux/amd64 --user "$(id -u):$(id -g)" --entrypoint tar \
    -v "$temporary:/target" "$image" -C /target -xf /target/backup.tar
}

restored_control_version=

restore_control() {
  local control="$1"
  local state_version="$2"
  if [[ ! -f "$control/MANIFEST" ]]; then
    if [[ "$state_version" != 2 || -e "$control/mail-edge.json" ]]; then
      printf 'backup control manifest is missing\n' >&2
      return 1
    fi
    [[ -f "$control/config.env" && -d "$control/secrets" ]]
    restored_control_version=0
    cp "$control/config.env" "$config_file"
    chmod 600 "$config_file"
    mkdir -p "$runtime_dir/secrets"
    cp "$control/secrets"/* "$runtime_dir/secrets/"
    chmod 600 "$runtime_dir/secrets"/*
    return
  fi
  grep -qx 'format=simplelogin-owned-provider-control' "$control/MANIFEST"
  grep -qx 'format_version=1' "$control/MANIFEST"
  local expected_config expected_mail_edge actual_config actual_mail_edge expected_secrets actual_secrets
  expected_config="$(sed -n 's/^config_sha256=//p' "$control/MANIFEST")"
  expected_mail_edge="$(sed -n 's/^mail_edge_config_sha256=//p' "$control/MANIFEST")"
  actual_config="$(shasum -a 256 "$control/config.env" | awk '{print $1}')"
  actual_mail_edge="$(shasum -a 256 "$control/mail-edge.json" | awk '{print $1}')"
  [[ "$expected_config" == "$actual_config" && "$expected_mail_edge" == "$actual_mail_edge" ]]
  expected_secrets="$(sed -n 's/^secret_names=//p' "$control/MANIFEST")"
  actual_secrets="$(find "$control/secrets" -maxdepth 1 -type f -exec basename {} \; | LC_ALL=C sort | python3 -c 'import json,sys; print(json.dumps([line.strip() for line in sys.stdin if line.strip()], separators=(",", ":")))')"
  [[ "$expected_secrets" == "$actual_secrets" ]]
  cp "$control/config.env" "$config_file"
  cp "$control/mail-edge.json" "$runtime_dir/mail-edge.json"
  chmod 600 "$config_file"
  mkdir -p "$runtime_dir/secrets"
  cp "$control/secrets"/* "$runtime_dir/secrets/"
  chmod 600 "$runtime_dir/mail-edge.json" "$runtime_dir/secrets"/*
  restored_control_version=1
}

reload_restored_configuration() {
  clear_configuration_environment
  load_env_file
  set_runtime_namespace
  if [[ -n "${SIMPLELOGIN_UPSTREAM_COMMIT:-}" && "$SIMPLELOGIN_UPSTREAM_COMMIT" != "$source_commit" ]]; then
    printf 'restored configuration differs from the pinned upstream commit\n' >&2
    return 1
  fi
  export OWNED_PROVIDER_RUNTIME_DIR="$runtime_dir"
  export OWNED_PROVIDER_CONFIG_FILE="$config_file"
  export OWNED_PROVIDER_SOURCE_COMMIT="$owned_provider_commit"
  export OWNED_PROVIDER_SOURCE_DATE_EPOCH="$owned_provider_source_epoch"
  export SIMPLELOGIN_UPSTREAM_COMMIT="$source_commit"
  if [[ "$restored_control_version" == 0 ]]; then
    python3 "$script_dir/scripts/mail_edge_config.py" "$runtime_dir/mail-edge.json"
  fi
  if [[ "${OWNED_PROVIDER_MAIL_EDGE_ENABLED:-0}" == "1" ]]; then
    export OWNED_PROVIDER_MAIL_EDGE_CONFIG_PATH=/run/mail-edge/config.json
  else
    unset OWNED_PROVIDER_MAIL_EDGE_CONFIG_PATH
  fi
}

run_restore() {
  local backup="${1:?restore requires an encrypted .opb backup}"
  backup="$(cd "$(dirname "$backup")" && pwd)/$(basename "$backup")"
  [[ "$backup" == *.opb && -f "$backup" ]]
  local temporary
  temporary="$(mktemp -d "$runtime_dir/backups/.restore.XXXXXX")"
  trap 'rm -rf -- "$temporary"' EXIT
  extract_backup "$backup" "$temporary"
  local state_version
  state_version="$(verify_export "$temporary/state")"
  restore_control "$temporary/control" "$state_version"
  reload_restored_configuration
  run_import "$temporary/state"
  rm -rf -- "$temporary"
  trap - EXIT
}

run_post_restore() {
  if ! is_test_mode; then
    printf 'automated post-restore mail proof requires the contained test sink\n' >&2
    return 1
  fi
  compose --profile tools run --rm --no-deps \
    -e OWNED_PROVIDER_BASE_URL=http://app:7777 \
    e2e python ops/owned-provider/scripts/post_restore.py
}

run_queue_drill() {
  if ! is_test_mode; then
    printf 'queue failure drill requires the contained test mail store\n' >&2
    return 1
  fi
  compose stop mailpit >/dev/null
  local created job_id
  created="$(compose --profile tools run --rm --no-deps e2e python ops/owned-provider/scripts/queue_resilience.py create | tail -1)"
  printf '%s\n' "$created"
  job_id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["job_id"])' "$created")"
  compose --profile tools run --rm --no-deps e2e \
    python ops/owned-provider/scripts/queue_resilience.py wait "$job_id" taken --timeout 60
  compose --profile tools run --rm --no-deps e2e \
    python ops/owned-provider/scripts/queue_resilience.py age "$job_id"
  compose start mailpit >/dev/null
  compose --profile tools run --rm --no-deps e2e \
    python ops/owned-provider/scripts/queue_resilience.py wait "$job_id" done --timeout 90
}

run_restart_drill() {
  if ! is_test_mode; then
    printf 'the restart traffic drill is restricted to contained test mode\n' >&2
    return 1
  fi
  compose restart app email job-runner >/dev/null
  wait_for_url "$(service_url observer 9090 /readyz)"
  run_post_restore
}

run_load() {
  if ! is_test_mode; then
    printf 'the destructive capacity fixture is restricted to contained test mode\n' >&2
    return 1
  fi
  local count="${1:-10000}"
  compose --profile tools run --rm --no-deps \
    -e OWNED_PROVIDER_E2E_DOMAIN="${OWNED_PROVIDER_E2E_DOMAIN:-mask.example.org}" \
    e2e python ops/owned-provider/scripts/load_profile.py --count "$count"
}

run_reconcile() {
  compose --profile tools run --rm --no-deps app \
    python ops/owned-provider/scripts/reconcile.py
}

run_mail_edge_restore_probe() {
  if ! is_test_mode; then
    printf 'the Mail Edge restore probe is restricted to contained test mode\n' >&2
    return 1
  fi
  compose --profile tools run --rm --no-deps \
    -e MAIL_EDGE_CONFIG_PATH=/run/mail-edge/config.json \
    e2e python ops/owned-provider/scripts/mail_edge_restore_probe.py "$@"
}

run_restore_fixture_verify() {
  if ! is_test_mode; then
    printf 'the restore fixture is restricted to contained test mode\n' >&2
    return 1
  fi
  local marker="${1:?restore fixture verification requires a marker}"
  local expected="${2:?restore fixture verification requires an expectation}"
  compose --profile tools run --rm --no-deps e2e \
    python ops/owned-provider/scripts/restore_fixture.py verify \
      "$marker" --expected "$expected"
}

run_drill() {
  if ! is_test_mode; then
    printf 'the destructive recovery drill is restricted to contained test mode\n' >&2
    return 1
  fi
  local stamp evidence backup checkpoint_marker after_marker capacity
  local mail_edge_checkpoint mail_edge_restore mail_edge_callback
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  evidence="$runtime_dir/evidence/drill-$stamp.json"
  backup="$runtime_dir/backups/drill-$stamp.opb"
  checkpoint_marker="checkpoint-$stamp"
  after_marker="after-$stamp"
  compose --profile tools run --rm e2e
  run_queue_drill
  run_restart_drill >/dev/null
  capacity="$(run_load 10000 | tail -1)"
  mail_edge_checkpoint="$(run_mail_edge_restore_probe seed | tail -1)"
  run_reconcile >/dev/null
  compose --profile tools run --rm --no-deps e2e \
    python ops/owned-provider/scripts/restore_fixture.py put "$checkpoint_marker" --phase checkpoint >/dev/null
  run_backup "$backup" >/dev/null
  compose --profile tools run --rm --no-deps e2e \
    python ops/owned-provider/scripts/restore_fixture.py put "$after_marker" --phase after-checkpoint >/dev/null
  local clean_runtime="$runtime_dir/clean-machine-$stamp"
  mkdir -p "$clean_runtime/secrets"
  chmod 700 "$clean_runtime" "$clean_runtime/secrets"
  cp "$runtime_dir/secrets/backup_encryption_key" "$clean_runtime/secrets/"
  chmod 600 "$clean_runtime/secrets/backup_encryption_key"
  (
    unset OWNED_PROVIDER_CONFIG_FILE
    OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" restore "$backup" >/dev/null
  )
  (
    unset OWNED_PROVIDER_CONFIG_FILE
    OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" restore-fixture-verify \
      "$checkpoint_marker" present >/dev/null
  )
  (
    unset OWNED_PROVIDER_CONFIG_FILE
    OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" restore-fixture-verify \
      "$after_marker" absent >/dev/null
  )
  (
    unset OWNED_PROVIDER_CONFIG_FILE
    OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" post-restore >/dev/null
  )
  mail_edge_restore="$(
    (
      unset OWNED_PROVIDER_CONFIG_FILE
      OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" mail-edge-restore-probe verify "$mail_edge_checkpoint"
    ) | tail -1
  )"
  mail_edge_callback="$(
    (
      unset OWNED_PROVIDER_CONFIG_FILE
      OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" mail-edge-restore-probe callback
    ) | tail -1
  )"
  (
    unset OWNED_PROVIDER_CONFIG_FILE
    OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" audit >/dev/null
  )
  (
    unset OWNED_PROVIDER_CONFIG_FILE
    OWNED_PROVIDER_RUNTIME_DIR="$clean_runtime" "$0" reconcile >/dev/null
  )
  local digest
  digest="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha256"])' "$clean_runtime/evidence/import-digest.json")"
  printf '{"backup":"%s","checkpoint_utc":"%s","database_sha256":"%s","capacity":%s,"mail_edge_state":%s,"mail_edge_callback":%s,"components":{"postgres":"restored","redis":"restored","uploads":"restored","unsent":"restored","mail_store":"restored","mail_edge_host_projections":"restored","mail_edge_config":"restored","mail_edge_secrets":"restored","mail_edge_spool":"ephemeral_recreated"},"post_restore_api_mail":"ok"}\n' \
    "$backup" "$stamp" "$digest" "$capacity" "$mail_edge_restore" "$mail_edge_callback" | tee "$evidence"
}

run_dns_preflight() {
  local domain="${1:?dns-preflight requires a domain}"
  local output="$runtime_dir/evidence/dns-${domain//[^A-Za-z0-9.-]/_}-$(date -u +%Y%m%dT%H%M%SZ).json"
  local args=(
    --domain "$domain"
    --outbound-ip "${OWNED_PROVIDER_OUTBOUND_IP:?set OWNED_PROVIDER_OUTBOUND_IP}"
    --dkim-private-key /run/secrets/dkim_private_key
  )
  local item
  while IFS= read -r item; do
    args+=(--mx-host "$item")
  done < <(python3 -c 'import ast,os; [print(host) for _,host in ast.literal_eval(os.environ["OWNED_PROVIDER_EMAIL_SERVERS_WITH_PRIORITY"])]')
  if [[ -n "${OWNED_PROVIDER_PTR_HOST:-}" ]]; then
    args+=(--ptr-host "$OWNED_PROVIDER_PTR_HOST")
  fi
  compose --profile tools run --rm --no-deps app \
    python ops/owned-provider/scripts/dns_preflight.py "${args[@]}" | tee "$output"
}

