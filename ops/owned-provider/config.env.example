# Non-secret contained test configuration. `owned-provider init` writes the
# effective copy beneath .owned-provider/ and keeps it out of Git. Production
# operators must start from config.production.env.example instead.
OWNED_PROVIDER_MODE=test
OWNED_PROVIDER_URL=http://127.0.0.1:17777
OWNED_PROVIDER_HTTP_PORT=17777
OWNED_PROVIDER_MAILPIT_HTTP_PORT=18025
OWNED_PROVIDER_OBSERVER_PORT=19090
OWNED_PROVIDER_ADMIN_EMAIL=operator@example.com
OWNED_PROVIDER_EMAIL_DOMAIN=aliases.example.com
OWNED_PROVIDER_ALIAS_DOMAINS='["aliases.example.com","aliases.example.net"]'
OWNED_PROVIDER_CUSTOM_DOMAINS='["mask.example.org"]'
OWNED_PROVIDER_E2E_DOMAIN=mask.example.org
# Used only for the real mailbox-verification test. The configured SMTP relay
# still captures delivery; the application performs the domain's live MX check.
OWNED_PROVIDER_E2E_MAILBOX_DOMAIN=gmail.com
OWNED_PROVIDER_ALIAS_LIMIT='100/day;50/hour;20/minute'
OWNED_PROVIDER_ALIAS_CREATE_RATE_LIMIT_PAID='500,60:10000,3600'
OWNED_PROVIDER_GUNICORN_WORKERS=2
OWNED_PROVIDER_SMTP_RELAY_HOST=mail-edge-smtp
OWNED_PROVIDER_SMTP_RELAY_PORT=2525
OWNED_PROVIDER_EMAIL_SERVERS_WITH_PRIORITY='[(10, "mailpit.")]'
OWNED_PROVIDER_SMTP_SIZE_LIMIT=26214400
OWNED_PROVIDER_MAIL_INGRESS_LEASE_SECONDS=300
OWNED_PROVIDER_MAIL_EDGE_AUTH_MAX_AGE_SECONDS=300
OWNED_PROVIDER_MAIL_EDGE_AUTH_FUTURE_SKEW_SECONDS=30
OWNED_PROVIDER_SYNTHETIC_INTERVAL_SECONDS=300
OWNED_PROVIDER_JOB_STALE_SECONDS=2100
OWNED_PROVIDER_TEST_MODE=1
