# Non-secret contained test configuration. `owned-provider init` writes the
# effective copy beneath .owned-provider/ and keeps it out of Git. Production
# operators must start from config.production.env.example instead.
OWNED_PROVIDER_MODE=test
OWNED_PROVIDER_URL=http://127.0.0.1:17777
OWNED_PROVIDER_HTTP_PORT=17777
OWNED_PROVIDER_SMTP_PORT=20381
OWNED_PROVIDER_MAILPIT_HTTP_PORT=18025
OWNED_PROVIDER_OBSERVER_PORT=19090
OWNED_PROVIDER_ADMIN_EMAIL=operator@example.com
OWNED_PROVIDER_EMAIL_DOMAIN=aliases.example.com
OWNED_PROVIDER_ALIAS_DOMAINS='["aliases.example.com","aliases.example.net"]'
OWNED_PROVIDER_CUSTOM_DOMAINS='["mask.example.org"]'
OWNED_PROVIDER_E2E_DOMAIN=mask.example.org
# Used only for the real mailbox-verification test. The configured SMTP relay
# still captures delivery; the application performs the domain's live MX check.
OWNED_PROVIDER_E2E_MAILBOX_DOMAIN=gmail.com
OWNED_PROVIDER_ALIAS_LIMIT='100/day;50/hour;20/minute'
OWNED_PROVIDER_ALIAS_CREATE_RATE_LIMIT_PAID='500,60:10000,3600'
OWNED_PROVIDER_GUNICORN_WORKERS=2
OWNED_PROVIDER_GUNICORN_TIMEOUT_SECONDS=90
OWNED_PROVIDER_APP_MEMORY_LIMIT=1536m
OWNED_PROVIDER_SMTP_RELAY_HOST=mailpit
OWNED_PROVIDER_SMTP_RELAY_PORT=1025
OWNED_PROVIDER_EMAIL_SERVERS_WITH_PRIORITY='[(10, "mailpit.")]'
OWNED_PROVIDER_SMTP_SIZE_LIMIT=26214400
OWNED_PROVIDER_SYNTHETIC_INTERVAL_SECONDS=300
OWNED_PROVIDER_JOB_STALE_SECONDS=2100
OWNED_PROVIDER_TEST_MODE=1

# Provider-neutral Mail Edge host. Leave disabled unless a compatible reference
# service is reachable. Enabling it makes durable Mail Edge handoff authoritative;
# an unavailable or ambiguous edge never falls back to SMTP.
OWNED_PROVIDER_MAIL_EDGE_ENABLED=0
OWNED_PROVIDER_MAIL_EDGE_TENANT_ID=01890f31-7b4a-7cc8-8d32-2f6e9a401111
OWNED_PROVIDER_MAIL_EDGE_BASE_URL=http://mail-edge-reference:8080
OWNED_PROVIDER_MAIL_EDGE_AUDIENCE=simplelogin-host
OWNED_PROVIDER_MAIL_EDGE_HOST_KEY_ID=host-key-current
OWNED_PROVIDER_MAIL_EDGE_PREVIOUS_HOST_KEY_ID=
OWNED_PROVIDER_MAIL_EDGE_OPERATOR_AUTHENTICATION_ENABLED=1
OWNED_PROVIDER_MAIL_EDGE_MAXIMUM_RAW_BYTES=26214400
OWNED_PROVIDER_MAIL_EDGE_CONNECT_SECONDS=1
OWNED_PROVIDER_MAIL_EDGE_READ_SECONDS=10
OWNED_PROVIDER_MAIL_EDGE_HTTP_CONCURRENCY=32
OWNED_PROVIDER_MAIL_EDGE_BREAKER_FAILURES=5
OWNED_PROVIDER_MAIL_EDGE_BREAKER_RESET_SECONDS=30
OWNED_PROVIDER_MAIL_EDGE_PRE_DISPATCH_RETRIES=1
OWNED_PROVIDER_MAIL_EDGE_MAXIMUM_JSON_BYTES=1048576
OWNED_PROVIDER_MAIL_EDGE_SHUTDOWN_SECONDS=30
OWNED_PROVIDER_MAIL_EDGE_SIGNATURE_MAXIMUM_AGE_SECONDS=300
OWNED_PROVIDER_MAIL_EDGE_SIGNATURE_FUTURE_SKEW_SECONDS=30
OWNED_PROVIDER_MAIL_EDGE_MAXIMUM_REQUEST_BYTES=1048576
OWNED_PROVIDER_MAIL_EDGE_CALLBACK_LEASE_SECONDS=60
OWNED_PROVIDER_MAIL_EDGE_CALLBACK_CONCURRENCY=8
OWNED_PROVIDER_MAIL_EDGE_DELIVERY_CONCURRENCY=2
OWNED_PROVIDER_MAIL_EDGE_MAXIMUM_IN_FLIGHT_RAW_BYTES=52428800
OWNED_PROVIDER_MAIL_EDGE_MAXIMUM_IN_FLIGHT_MEMORY_BYTES=268435456
OWNED_PROVIDER_MAIL_EDGE_MAXIMUM_PROCESS_RSS_BYTES=536870912
OWNED_PROVIDER_MAIL_EDGE_MINIMUM_SPOOL_FREE_BYTES=67108864
OWNED_PROVIDER_MAIL_EDGE_ESTIMATED_MEMORY_MULTIPLIER=8
OWNED_PROVIDER_MAIL_EDGE_ESTIMATED_MEMORY_FIXED_BYTES=8388608
OWNED_PROVIDER_MAIL_EDGE_MIME_MAXIMUM_PARTS=256
OWNED_PROVIDER_MAIL_EDGE_MIME_MAXIMUM_DEPTH=16
OWNED_PROVIDER_MAIL_EDGE_MIME_MAXIMUM_HEADER_COUNT=1024
OWNED_PROVIDER_MAIL_EDGE_MIME_MAXIMUM_HEADER_BYTES=1048576
OWNED_PROVIDER_MAIL_EDGE_MIME_MAXIMUM_LINE_BYTES=1048576
OWNED_PROVIDER_MAIL_EDGE_MIME_MAXIMUM_SEMANTIC_BYTES=104857600
OWNED_PROVIDER_MAIL_EDGE_MIME_PARSER_SECONDS=10
