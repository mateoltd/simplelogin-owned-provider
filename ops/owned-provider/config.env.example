# Non-secret local deployment configuration. `owned-provider init` writes the
# effective copy beneath .owned-provider/ and keeps it out of Git.
OWNED_PROVIDER_HTTP_PORT=17777
OWNED_PROVIDER_SMTP_PORT=20381
OWNED_PROVIDER_MAILPIT_HTTP_PORT=18025
OWNED_PROVIDER_ADMIN_EMAIL=admin@mailbox.lan
OWNED_PROVIDER_EMAIL_DOMAIN=sl.lan
OWNED_PROVIDER_ALIAS_DOMAINS='["sl.lan","aliases.sl.lan"]'
OWNED_PROVIDER_CUSTOM_DOMAIN=owned.lan
OWNED_PROVIDER_ALIAS_LIMIT='100/day;50/hour;20/minute'
OWNED_PROVIDER_GUNICORN_WORKERS=2
