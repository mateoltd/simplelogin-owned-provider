# Copy to a mode-0600 file outside Git and replace every example value.
OWNED_PROVIDER_MODE=production
OWNED_PROVIDER_URL=https://aliases.example.com
OWNED_PROVIDER_HTTP_BIND=127.0.0.1
OWNED_PROVIDER_HTTP_PORT=17777
OWNED_PROVIDER_SMTP_BIND=0.0.0.0
OWNED_PROVIDER_SMTP_PORT=25
OWNED_PROVIDER_OBSERVER_BIND=127.0.0.1
