# Copy to a mode-0600 file outside Git and replace every example value.
OWNED_PROVIDER_MODE=production
OWNED_PROVIDER_URL=https://aliases.example.com
OWNED_PROVIDER_HTTP_BIND=127.0.0.1
OWNED_PROVIDER_HTTP_PORT=17777
OWNED_PROVIDER_SMTP_BIND=0.0.0.0
OWNED_PROVIDER_SMTP_PORT=25
OWNED_PROVIDER_OBSERVER_BIND=127.0.0.1
OWNED_PROVIDER_OBSERVER_PORT=19090
OWNED_PROVIDER_ADMIN_EMAIL=operator@example.net
OWNED_PROVIDER_EMAIL_DOMAIN=aliases.example.com
OWNED_PROVIDER_ALIAS_DOMAINS='["aliases.example.com"]'
OWNED_PROVIDER_CUSTOM_DOMAINS='["mask.example.org","relay.example.net"]'
OWNED_PROVIDER_ALIAS_LIMIT='1000/day;300/hour;50/minute'
OWNED_PROVIDER_ALIAS_CREATE_RATE_LIMIT_PAID='500,60:10000,3600'
OWNED_PROVIDER_GUNICORN_WORKERS=4
OWNED_PROVIDER_SMTP_RELAY_HOST=postfix.internal
OWNED_PROVIDER_SMTP_RELAY_PORT=25
OWNED_PROVIDER_SMTP_BACKUP_RELAYS=
OWNED_PROVIDER_EMAIL_SERVERS_WITH_PRIORITY='[(10, "mx1.example.com."),(20, "mx2.example.com.")]'
OWNED_PROVIDER_SMTP_SIZE_LIMIT=26214400
OWNED_PROVIDER_SYNTHETIC_INTERVAL_SECONDS=300
OWNED_PROVIDER_JOB_STALE_SECONDS=2100
OWNED_PROVIDER_OUTBOUND_IP=192.0.2.10
OWNED_PROVIDER_PTR_HOST=mx1.example.com
