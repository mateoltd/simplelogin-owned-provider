# Paths only. Store effective configuration and all referenced files outside Git.
MAIL_EDGE_DATABASE_URL_FILE=/run/secrets/mail-edge-database-url
MAIL_EDGE_BLOB_ROOT=/var/lib/mail-edge/blobs
MAIL_EDGE_BLOB_KEYS_FILE=/run/secrets/mail-edge-blob-keys
MAIL_EDGE_PROVIDER_CREDENTIALS_FILE=/run/secrets/mail-edge-provider-credentials
MAIL_EDGE_DIAGNOSTIC_SALT_FILE=/run/secrets/mail-edge-diagnostic-salt
MAIL_EDGE_HANDOFF_URL=https://simplelogin-internal.example/v1/mail-edge/inbound
MAIL_EDGE_HANDOFF_TOKEN_FILE=/run/secrets/mail-edge-handoff-token
MAIL_EDGE_HOOK_TLS_CERT_FILE=/run/tls/fullchain.pem
MAIL_EDGE_HOOK_TLS_KEY_FILE=/run/tls/private-key.pem
MAIL_EDGE_HOOK_HOST=127.0.0.1
MAIL_EDGE_HOOK_PORT=8443
MAIL_EDGE_SMTP_HOST=127.0.0.1
MAIL_EDGE_SMTP_PORT=2525
MAIL_EDGE_METRICS_HOST=127.0.0.1
MAIL_EDGE_METRICS_PORT=9090
MAIL_EDGE_MAX_MESSAGE_BYTES=26214400
